import requests
from bs4 import BeautifulSoup

url = "https://grcodeclub.gr"  # 🔁 άλλαξε το με όποια σελίδα θες

response = requests.get(url)
soup = BeautifulSoup(response.text, 'html.parser')

print("META INFO ΓΙΑ:", url)
print("=" * 40)

# Title
if soup.title:
    print("Title:", soup.title.get_text(strip=True))

# Charset
charset = soup.find('meta', charset=True)
if charset:
    print("Charset:", charset['charset'])

# Viewport
viewport = soup.find('meta', attrs={'name': 'viewport'})
if viewport:
    print("Viewport:", viewport.get("content", ""))

# Description
description = soup.find('meta', attrs={'name': 'description'})
if description:
    print("Description:", description.get("content", ""))

# Keywords
keywords = soup.find('meta', attrs={'name': 'keywords'})
if keywords:
    print("Keywords:", keywords.get("content", ""))

# Open Graph Tags (og:)
og_tags = soup.find_all('meta', property=lambda value: value and value.startswith('og:'))
for tag in og_tags:
    print(f"{tag['property']}: {tag.get('content', '')}")

# Twitter Cards
twitter_tags = soup.find_all('meta', attrs={'name': lambda name: name and name.startswith('twitter:')})
for tag in twitter_tags:
    print(f"{tag['name']}: {tag.get('content', '')}")
